# AutoNetSim — copy this file to `.env` and fill in YOUR OWN values.
# The dashboard reads .env at startup (via web/routes/env_loader.py).
#
# .env is gitignored — never commit real API keys.

# ─── LLM provider for the dashboard's chat ─────────────────────────
# Any OpenAI-compatible endpoint works: Anthropic direct, an OpenAI-compat
# relay (Kimi, PackyCode, exchangetoken, ...), or a local model server.
#
# --- Option A: Anthropic direct (recommended) ---
# DASHBOARD_CHAT_BASE_URL=https://api.anthropic.com/v1
# DASHBOARD_CHAT_API_KEY=sk-ant-YOUR-KEY-HERE
# DASHBOARD_CHAT_MODEL=claude-sonnet-4-6
#
# --- Option B: OpenAI-compat relay (Kimi / exchangetoken / PackyCode / ...) ---
# DASHBOARD_CHAT_BASE_URL=https://<gateway>/v1
# DASHBOARD_CHAT_API_KEY=sk-YOUR-RELAY-KEY
# DASHBOARD_CHAT_MODEL=claude-sonnet-4-6
#
# --- Option C: Local model (Ollama / LM Studio / vLLM) ---
# DASHBOARD_CHAT_BASE_URL=http://localhost:11434/v1
# DASHBOARD_CHAT_API_KEY=ollama-local-no-key
# DASHBOARD_CHAT_MODEL=llama3.1

DASHBOARD_CHAT_BASE_URL=https://api.anthropic.com/v1
DASHBOARD_CHAT_API_KEY=sk-ant-PUT-YOUR-KEY-HERE
DASHBOARD_CHAT_MODEL=claude-sonnet-4-6
# Per-call HTTP timeout in seconds (default 300). Raise it if you see
# "[worker error] TimeoutError" with a large model behind a slow gateway.
# DASHBOARD_CHAT_TIMEOUT=300

# ─── 3D-FUTURE furniture dataset (optional) ─────────────────────────
# Point at the extracted 3D-FUTURE-model/ directory. Contains model_info.json
# and one UUID subdirectory per furniture piece (each with raw_model.obj).
# Register + download from https://tianchi.aliyun.com/dataset/98063
#
# If unset or path is invalid, the dashboard falls back to simple box
# meshes — RF simulation still works (ray tracing uses AABB anyway).
FUTURE_DATASET_PATH=/path/to/3D-FUTURE-model

# ─── Skill / benchmark tuning (optional) ─────────────────────────────
# Which skill files to inject as the chat's system prompt. Comma-separated.
# Paths are relative to .claude/skills/rf-simulator/  OR absolute.
# Defaults to loading SKILL.md + Sionna v2 API + benchmark task_tail.
# DASHBOARD_CHAT_SKILL_FILES=SKILL.md,references/sionna-v2-api.md
